@model IEnumerable<T1CAMPOSCRUZJHOSEPANTONY.Models.LibroViewModel>

@{
    ViewData["Title"] = "Catálogo de libros";
}

<div class="container mt-4">
    <h1 class="display-5 fw-bold mb-1">Catálogo de libros</h1>
    <p class="text-muted fs-5 mb-4">Bienvenido a la biblioteca</p>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-end align-items-center mb-4">
        <a asp-action="Create" class="btn btn-success">+ Registrar</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 90px;">Código</th>
                    <th>Categoría</th>
                    <th>Título</th>
                    <th>ISBN</th>
                    <th class="text-center">Año</th>
                    <th class="text-end">Stock</th>
                    <th class="text-center">Estado</th>
                    <th style="width: 100px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CodLibro</td>
                        <td>@item.NombreCategoria</td>
                        <td>@item.Titulo</td>
                        <td>@item.ISBN</td>
                        <td class="text-center">@item.AnioPublicacion</td>
                        <td class="text-end">@item.Stock</td>
                        <td class="text-center">
                            @if (item.Estado == 1)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.CodLibro" class="btn btn-info btn-sm text-dark">Ver</a>
                                <a asp-action="Edit" asp-route-id="@item.CodLibro" class="btn btn-warning btn-sm">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.CodLibro" class="btn btn-danger btn-sm">Eliminar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
